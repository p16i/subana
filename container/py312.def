BootStrap: docker
From: python:3.12.1

%labels
    Author: pat.chormai@gmail.com
    Version v0.0.1

%files
    ./pyproject.toml
    ./uv.lock

%environment
    export PYTHONPATH=.

%post
  pip install --upgrade pip
  pip install uv
  uv export --project . --all-groups --no-hashes --no-emit-project --format requirements-txt -o requirements.txt
  cat requirements.txt
  uv pip install --system -r requirements.txt

%test
   python --version